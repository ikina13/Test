generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// Enums
// =========================

enum RoleName {
  SUPER_ADMIN
  ADMIN
  TREASURER
  USHER
  MEMBER
}

enum AnnouncementType {
  GENERAL
  URGENT
  EVENT_PROMO
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RSVPStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum PaymentMethod {
  CASH
  STRIPE
  PAYPAL
  MPESA
}

enum AssetCondition {
  NEW
  GOOD
  NEEDS_REPAIR
  BROKEN
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum PettyCashDirection {
  ADD
  SPEND
}

enum MediaType {
  AUDIO
  VIDEO
  PDF
}

enum ProcurementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  DELIVERED
  CLOSED
}

enum FamilyRelationship {
  HEAD
  SPOUSE
  CHILD
  OTHER
}

// =========================
// Core Auth & RBAC
// =========================

model User {
  id                                String                   @id @default(cuid())
  email                             String                   @unique
  passwordHash                      String
  firstName                         String
  lastName                          String
  phone                             String?
  isActive                          Boolean                  @default(true)
  createdAt                         DateTime                 @default(now())
  updatedAt                         DateTime                 @updatedAt

  // Relations
  roles                             UserRole[]
  member                            Member?
  donationsReceived                 Donation[]               @relation("DonationReceivedBy")
  eventAttendanceMarked             EventAttendance[]        @relation("AttendanceMarkedBy")
  createdEvents                     Event[]                  @relation("EventsCreatedBy")
  rosterAssignments                 RosterAssignment[]
  pettyCashTransactionsCreated      PettyCashTransaction[]   @relation("PettyCashCreatedBy")
  pettyCashTransactionsApproved     PettyCashTransaction[]   @relation("PettyCashApprovedBy")
}

model Role {
  id    Int        @id @default(autoincrement())
  name  RoleName   @unique

  users UserRole[]
}

model UserRole {
  userId String
  roleId Int

  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// =========================
// Members & Families
// =========================

model Member {
  id             String            @id @default(cuid())
  userId         String?           @unique
  firstName      String
  lastName       String
  gender         Gender?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  joinDate       DateTime?
  baptismDate    DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  user           User?             @relation(fields: [userId], references: [id])
  familyLinks    FamilyMember[]
  donations      Donation[]
  eventRsvps     EventRSVP[]
  attendances    EventAttendance[]
}

model Family {
  id          String          @id @default(cuid())
  familyName  String
  notes       String?

  members     FamilyMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FamilyMember {
  id         String             @id @default(cuid())
  familyId   String
  memberId   String
  relation   FamilyRelationship

  family     Family             @relation(fields: [familyId], references: [id])
  member     Member             @relation(fields: [memberId], references: [id])

  @@unique([familyId, memberId])
}

// =========================
// Announcements
// =========================

model Announcement {
  id               String            @id @default(cuid())
  title            String
  content          String
  type             AnnouncementType
  isPublic         Boolean           @default(true)   // visible on public website
  isMemberPortal   Boolean           @default(true)   // visible in member portal
  published        Boolean           @default(false)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// =========================
// Events, RSVPs & Attendance
// =========================

model Event {
  id               String              @id @default(cuid())
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime?
  location         String?
  isPublic         Boolean             @default(true)
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  createdBy        User?               @relation("EventsCreatedBy", fields: [createdById], references: [id])
  rsvps            EventRSVP[]
  attendance       EventAttendance[]
  rosterAssignments RosterAssignment[]
}

model EventRSVP {
  eventId   String
  memberId  String
  status    RSVPStatus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event     Event     @relation(fields: [eventId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id])

  @@id([eventId, memberId])
}

model EventAttendance {
  eventId         String
  memberId        String
  checkedInAt     DateTime?
  markedByUserId  String?

  event           Event   @relation(fields: [eventId], references: [id])
  member          Member  @relation(fields: [memberId], references: [id])
  markedBy        User?   @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])

  @@id([eventId, memberId])
}

// =========================
// Offerings & Donations
// =========================

model DonationType {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  active   Boolean    @default(true)

  donations Donation[]
}

model Donation {
  id                 String         @id @default(cuid())
  memberId           String?
  donationTypeId     Int
  amount             Decimal        @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  externalReference  String?
  receiptNumber      String?        @unique
  receivedByUserId   String?
  createdAt          DateTime       @default(now())

  member             Member?        @relation(fields: [memberId], references: [id])
  donationType       DonationType    @relation(fields: [donationTypeId], references: [id])
  receivedBy         User?           @relation("DonationReceivedBy", fields: [receivedByUserId], references: [id])
}

// =========================
// Ushers & Duty Roster
// =========================

model RosterAssignment {
  id        String    @id @default(cuid())
  date      DateTime
  serviceName String?
  eventId   String?
  role      RoleName
  userId    String

  event     Event?    @relation(fields: [eventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

// =========================
// Assets Management
// =========================

model Asset {
  id            String            @id @default(cuid())
  name          String
  category      String?
  purchaseDate  DateTime?
  cost          Decimal?          @db.Decimal(12, 2)
  condition     AssetCondition    @default(GOOD)
  serialNumber  String?
  notes         String?

  assignments   AssetAssignment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AssetAssignment {
  id                 String   @id @default(cuid())
  assetId            String
  assignedToUserId   String?
  assignedToEventId  String?
  assignedAt         DateTime @default(now())
  returnedAt         DateTime?

  asset              Asset    @relation(fields: [assetId], references: [id])
  assignedToUser     User?    @relation(fields: [assignedToUserId], references: [id])
  assignedToEvent    Event?   @relation(fields: [assignedToEventId], references: [id])
}

// =========================
// Finance & Petty Cash
// =========================

model FinanceCategory {
  id     Int         @id @default(autoincrement())
  name   String
  type   FinanceType

  transactions FinanceTransaction[]

  @@unique([name, type])
}

model FinanceTransaction {
  id           String       @id @default(cuid())
  type         FinanceType
  categoryId   Int?
  amount       Decimal      @db.Decimal(12, 2)
  date         DateTime     @default(now())
  description  String?
  isPettyCash  Boolean      @default(false)
  createdById  String?

  category     FinanceCategory? @relation(fields: [categoryId], references: [id])
  createdBy    User?            @relation(fields: [createdById], references: [id])
}

model PettyCashTransaction {
  id            String             @id @default(cuid())
  direction     PettyCashDirection
  amount        Decimal            @db.Decimal(12, 2)
  description   String?
  date          DateTime           @default(now())
  createdById   String?
  approvedById  String?

  createdBy     User?              @relation("PettyCashCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?              @relation("PettyCashApprovedBy", fields: [approvedById], references: [id])
}

// =========================
// Procurement
// =========================

model Vendor {
  id         String           @id @default(cuid())
  name       String
  email      String?
  phone      String?
  address    String?
  notes      String?

  requisitions   Requisition[]
  purchaseOrders PurchaseOrder[]
}

model Requisition {
  id             String              @id @default(cuid())
  requestedById  String
  status         ProcurementStatus   @default(DRAFT)
  description    String?
  createdAt      DateTime            @default(now())

  requestedBy    User                @relation(fields: [requestedById], references: [id])
  items          RequisitionItem[]
  purchaseOrders PurchaseOrder[]
}

model RequisitionItem {
  id                 String       @id @default(cuid())
  requisitionId      String
  name               String
  quantity           Int
  estimatedUnitPrice Decimal?     @db.Decimal(12, 2)
  vendorId           String?

  requisition        Requisition  @relation(fields: [requisitionId], references: [id])
  vendor             Vendor?      @relation(fields: [vendorId], references: [id])
}

model PurchaseOrder {
  id                String               @id @default(cuid())
  requisitionId     String?
  vendorId          String
  status            ProcurementStatus    @default(ORDERED)
  orderedAt         DateTime             @default(now())
  expectedDelivery  DateTime?

  requisition       Requisition?         @relation(fields: [requisitionId], references: [id])
  vendor            Vendor               @relation(fields: [vendorId], references: [id])
  items             PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  name             String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  deliveredQuantity Int           @default(0)

  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
}

// =========================
// Public Website - Sermons
// =========================

model Sermon {
  id            String     @id @default(cuid())
  title         String
  description   String?
  speaker       String?
  date          DateTime   @default(now())
  mediaType     MediaType
  mediaUrl      String
  thumbnailUrl  String?
  fileSizeBytes Int?
  published     Boolean    @default(false)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

